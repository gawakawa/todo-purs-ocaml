{
  "name": "todo-purs-ocaml",
  "compatibility_date": "2026-08-30",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "containers": [
    {
      "image": "registry.cloudflare.com/7408698469c4de69546d83a071fb9a90/todo-backend:v1",
      "class_name": "Backend",
      "instance_type": "lite",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }],
}
